{{!
    @template format_flexsections/sectionstatus
    Section complition/submission status.
}}

{{#waitingforsubmission}}
<div class="d-flex align-items-center mb-3" id="waitingForSubmission">
    <i class="fa-light fa-hourglass-end text-secondary d-flex align-items-center justify-content-center"></i>
    <span class="info-block-value text-secondary px-2">{{value}}</span>
    <span class="info-block-text">{{#str}} statuswaitingforsubmission, format_flexsections {{/str}}</span>
</div>
{{/waitingforsubmission}}

{{#failed}}
<div class="d-flex align-items-center mb-3" id="failed">
    <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center">
        <i class="fa-light fa-triangle-exclamation text-white"></i>
    </div>
    <span class="info-block-value text-secondary px-2">{{value}}</span>
    <span class="info-block-text">{{#str}} statusfailed, format_flexsections {{/str}}</span>
</div>
{{/failed}}

{{#notsubmitted}}
<div class="d-flex align-items-center mb-3" id="notSubmitted">
    <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center">
        <i class="fa-light fa-triangle-exclamation text-white"></i>
    </div>
    <span class="info-block-value text-secondary px-2">{{value}}</span>
    <span class="info-block-text">{{#str}} statusnotsubmittedintime, format_flexsections {{/str}}</span>
{{/notsubmitted}}