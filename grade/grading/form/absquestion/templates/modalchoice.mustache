<div class="modal" id="choice_modal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{#str}}are_you_sure, gradingform_absquestion{{/str}}</h4>
                <button type="button" class="close" data-dismiss="modal">×</button>
            </div>
            <div class="modal-footer">
                <button data-dismiss="modal" id="choice_modal_yes" class="btn btn-primary">{{#str}}yes, gradingform_absquestion{{/str}}</button>
                <button data-dismiss="modal" class="btn btn-primary">{{#str}}no, gradingform_absquestion{{/str}}</button>
            </div>
        </div>
    </div>
</div>