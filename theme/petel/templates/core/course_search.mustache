{{!
    @template petel/course_search

    This template renders the course search form.

    Example context (json):
    {
    }

    Page header.
}}
<div id="course_activity_search" class="form-inline" style="width: fit-content">
    <input id="course_activity_search-input" class="form-control" type="text"
           placeholder="{{#str}} searchcourse, theme_petel {{/str}}" role="search"
           aria-label="{{#str}} searchcourse, theme_petel {{/str}}"/>
    <input type="hidden" id="course_activity_search_count" value="$count" />
</div>
