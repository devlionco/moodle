    <div class = "intro_card">
      <div class = "intro_icon intro_icon--language"></div>
      <span class = "intro_text-preview">{{#str}}socialcard1, community_social{{/str}}</span>
    </div>
    <div class = "intro_card">
      <div class = "intro_icon intro_icon--media"></div>
      <span class = "intro_text-preview">{{#str}}socialcard2, community_social{{/str}}</span>
    </div>
    <div class = "intro_card">
      <div class = "intro_icon intro_icon--notifications-active"></div>
      <span class = "intro_text-preview">{{#str}}socialcard3, community_social{{/str}}</span>
    </div>
    <div class = "intro_card">
      <div class = "intro_icon intro_icon--supervised"></div>
      <span class = "intro_text-preview">{{#str}}socialcard4, community_social{{/str}}</span>
    </div>
  </div>

  <!--<a href = "javascript:void(0)" class = "intro_btn intro_btn--small">{{#str}}moreinfo, community_social{{/str}}</a>-->
