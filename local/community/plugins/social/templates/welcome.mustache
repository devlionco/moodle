<div class = "intro_wrapper">
  <div class = "intro">
    <h1 class = "intro_head">{{#str}}welcomesocialarea, community_social{{/str}}</h1>
    <div class = "intro_par">{{#str}}socialgreeting, community_social{{/str}}</div>
    <div class = "intro_par"><b>{{#str}}importanttoknow, community_social{{/str}}</b> {{#str}}importantinformation, community_social{{/str}}</div>
    <a href = "{{{social_enable}}}" class = "intro_btn">{{#str}}activatingsocial, community_social{{/str}}</a>
  </div>
</div>

<div class = "intro_wrap">
  <h2 class = "intro_head intro_head--bold">{{#str}}socialarea, community_social{{/str}}</h2>
