<div class="modal-header">
  <h5 class="modal-title">{{title}}</h5>
  <button type="button" data-ref="close" class="close" data-dismiss="modal" aria-label="Close">
    <span aria-hidden="true">×</span>
  </button>
</div>

<div class="modal-body">
    {{text}}
</div>

<div class="modal-footer">
  {{^isAmit}}
    <button class="btn btn-secondary" type="button" data-handler = "goBack">{{#str}}back, community_sharewith{{/str}}</button>
  {{/isAmit}}
  <button class="btn btn-warning" type="button" data-dismiss="modal">{{#str}}approve, community_sharewith{{/str}}</button>
</div>
