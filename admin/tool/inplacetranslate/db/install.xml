<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/inplacetranslate/db" VERSION="20120122" COMMENT="XMLDB file for Moodle admin/tool/inplacetranslate"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="tool_inplacetranslate" COMMENT="Custom lang strings">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="component" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The component of the string"/>
                <FIELD NAME="lang" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="The lang of the string"/>
                <FIELD NAME="stringid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The identifier of the string"/>
                <FIELD NAME="string" TYPE="text" LENGTH="big" NOTNULL="false" SEQUENCE="false" COMMENT="Custom string"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The timestamp of when the string was created"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The timestamp of when the string was modified"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
				<INDEX NAME="component" UNIQUE="false" FIELDS="component" COMMENT=""/>
				<INDEX NAME="lang" UNIQUE="false" FIELDS="lang" COMMENT=""/>
				<INDEX NAME="stringid" UNIQUE="false" FIELDS="stringid" COMMENT=""/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>